// Probe 1c: shifts.
//   TRACE_1  -16 >> 2   (arithmetic gives -4; logical gives 1073741820)
//   TRACE_2  -1 >> 31   (arithmetic gives -1; logical gives 1)
//   TRACE_3  1 << 31    (gives -2147483648)
//   TRACE_4  1 << 32    (count masked to 0 gives 1; else 0)
//   TRACE_5  5 >> 33    (count masked to 1 gives 2; else 0)
//   TRACE_6  (1 << -1) >> 16  (count masked to 31 gives -32768; 0 if negative counts give 0)
// TRACE_4..6 are 16-bit on the Zen, so TRACE_6 is shifted down to fit.

int neg16, neg1, one, five, s2, s31, s32, s33, sneg;

init {
    neg16 = -16; neg1 = -1; one = 1; five = 5;
    s2 = 2; s31 = 31; s32 = 32; s33 = 33; sneg = -1;
}

main {
    set_val(TRACE_1, neg16 >> s2);
    set_val(TRACE_2, neg1 >> s31);
    set_val(TRACE_3, one << s31);
    set_val(TRACE_4, one << s32);
    set_val(TRACE_5, five >> s33);
    set_val(TRACE_6, (one << sneg) >> 16);
}
